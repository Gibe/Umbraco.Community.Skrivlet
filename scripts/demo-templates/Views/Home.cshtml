@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Community.SkrivLet.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Home>
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@Model.Name</title>
	<link rel="stylesheet" href="~/App_Plugins/UmbracoCommunitySkrivLet/basic-theme.css">
	<link rel="stylesheet" href="~/css/demo.css">
</head>
<body>
	<header class="site-header">
		<div class="container">
			<span class="site-title">Umbraco.Community.SkrivLet demo</span>
		</div>
	</header>
	<main class="container">
		@await Html.RenderSkrivLet(Model.Content)
	</main>
</body>
</html>
